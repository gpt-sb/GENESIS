# Byte-compiled / cache
__pycache__/
*.py[cod]
*.so
.DS_Store

# Large generative-model checkpoints hosted on Zenodo (~325MB total, largest
# individual file 63MB) -- see README.md "Large Files (Zenodo)". The small
# PGCL checkpoints (best.pt + 3 multiseed checkpoints, <10MB each) ARE tracked directly.
generative/checkpoints/*.pt

# Pre-computed MolDeBERTa embeddings hosted on Zenodo (~1.4GB, not tracked)
embeddings/

# Local-only illustrative/meta diagrams (not part of the reproducibility
# pipeline or the manuscript) -- generator script may be tracked, outputs are not.
# The graphical abstract is the one approved exception, tracked for README.md.
docs/images/*.png
!docs/images/Fig_GENESIS_Graphical_Abstract.png

# OS / editor
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.log

